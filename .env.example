# =============================================================================
#  AUTOLINK - ARCHIVO DE CONFIGURACIÓN DE ENTORNO
#  Guía de instalación y puesta en marcha
# =============================================================================
#
# INSTRUCCIONES DE USO:
#
#   1. Copia este archivo y renómbralo a ".env":
#        cp .env.example .env
#
#   2. Rellena TODOS los valores vacíos con tus propias credenciales
#      siguiendo las indicaciones de cada sección.
#
#   3. NUNCA subas el archivo ".env" a GitHub ni a ningún repositorio público.
#      El archivo ".env.example" (este) SÍ puede subirse al repositorio.
#
#   4. Levanta el proyecto con Docker Compose:
#        - Para entorno LOCAL:      docker-compose -f docker-compose.local.yml up -d
#        - Para entorno PRODUCCIÓN: docker-compose -f docker-compose.prod.yml up -d
#
#   5. (Solo producción) Obtén un certificado SSL gratuito con Let's Encrypt:
#        certbot --nginx -d tudominio.com -d www.tudominio.com
#
# =============================================================================


# --- BASE DE DATOS (MariaDB) --------------------------------------------------
# Contraseña del usuario principal de la base de datos.
# Usa una contraseña segura de al menos 16 caracteres.
# Ejemplo: DB_PASSWORD=K9xM2#pL8wQrZ7nT
DB_PASSWORD=

# Contraseña del usuario root de MariaDB (acceso total a la BD).
# Recomendación: usa una contraseña diferente a DB_PASSWORD.
MYSQL_ROOT_PASSWORD=

# Nombre del esquema (base de datos) que usará la aplicación. No cambiar.
MYSQL_DATABASE=autolink


# --- SEGURIDAD JWT ------------------------------------------------------------
# Clave secreta usada para firmar los tokens de autenticación de usuarios.
# IMPORTANTE: debe ser una cadena aleatoria de mínimo 32 caracteres.
# Puedes generarla con: openssl rand -base64 32
JWT_SECRET=


# --- CORREO ELECTRÓNICO (Gmail SMTP) -----------------------------------------
# Cuenta de Gmail usada para enviar correos de verificación y notificaciones.
#
# PASO A PASO PARA CONFIGURARLO CON GMAIL:
#   1. Ve a tu cuenta de Google → Seguridad → Verificación en dos pasos (actívala).
#   2. Ve a: https://myaccount.google.com/apppasswords
#   3. Crea una "Contraseña de aplicación" para "Correo" y "Windows/Mac".
#   4. Copia la contraseña de 16 caracteres generada y pégala en MAIL_PASSWORD.
#   NOTA: No uses tu contraseña normal de Gmail, usa la contraseña de aplicación.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Email del administrador que recibirá notificaciones del sistema.
ADMIN_EMAIL=


# --- CORS (Orígenes permitidos) -----------------------------------------------
# Dirección desde la que el navegador accede a la aplicación.
# En local con Docker y Nginx:    http://localhost
# En producción con dominio:      https://tudominio.com
CORS_ALLOWED_ORIGIN=http://localhost


# --- GOOGLE reCAPTCHA v2 ------------------------------------------------------
# Clave secreta para validar el captcha en el formulario de login.
# Regístrate en: https://www.google.com/recaptcha/admin/create
#   - Tipo: reCAPTCHA v2 ("No soy un robot")
#   - Dominios: localhost (para local) y tudominio.com (para producción)
# Copia la "Clave secreta" (no la clave del sitio) aquí.
RECAPTCHA_SECRET=


# --- SEGURIDAD NGINX (Acceso a phpMyAdmin) ------------------------------------
# Clave personalizada que protege el acceso al panel de base de datos (/admin-pma).
# Solo los administradores de la aplicación necesitarán introducirla.
# Usa una clave compleja. Ejemplo: Adm1n#DB_S3cur3!
PMA_SECURITY_KEY=
